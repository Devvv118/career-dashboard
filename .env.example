# Leave all of these unset to show the bundled sample data (the public deployment does this).
# Set them to switch to live data.

# Email report endpoint (API Gateway invoke URL, include the route path)
# VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/report

# Portfolio backend + stats key. Without the key, the Portfolio tab asks for it in the UI.
# A key set here is baked into the build, so anyone who loads the site can read it.
# VITE_PORTFOLIO_API_URL=https://your-portfolio-backend.onrender.com
# VITE_PORTFOLIO_STATS_KEY=
